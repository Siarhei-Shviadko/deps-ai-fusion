ENV=local

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=ai-fusion
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
MASTER_CHANGELOG=./migrations/master.yaml
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

SENTRY_ENABLED=False
SENTRY_DSN=

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps

# kafka
KAFKA_GROUP_ID=ai-fusion

# Auth
AUTH_VERIFY_SSL=false

ASB_SUBSCRIPTION_NAME=ai-fusion

SUPPORTED_PROVIDERS='["dial", "azure", "aws-bedrock", "google"]'

LITELLM_ENABLED=false
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-1234
LITELLM_TIMEOUT=300
LITELLM_MODEL_MAP='{
      "dial": {
        "openai.gpt-4.1-mini-text": "dial/gpt-4.1-mini",
        "openai.gpt-4-omni-text": "dial/gpt-4o",
        "openai.gpt-5-mini-text": "dial/gpt-5-mini",
        "anthropic.claude-haiku-4-5": "dial/claude-haiku-4-5",
        "anthropic.claude-sonnet-4-5": "dial/claude-sonnet-4-5",
        "epam.dial-rag": "dial/rag",
        "anthropic.claude-4.6-multimodal": "dial/claude-sonnet-4-6"
      },
      "azure": {
        "openai.gpt-5-mini-text": "dial/gpt-5-mini",
        "openai.gpt-4-omni-text": "dial/gpt-4o"
      },
      "aws-bedrock": {
        "anthropic.claude-4.6-multimodal": "bedrock/claude-sonnet-4-6",
        "anthropic.claude-4.5-text": "bedrock/claude-sonnet-4-5",
        "anthropic.claude-images": "bedrock/claude-sonnet-4-5",
        "amazon.nova-pro-text": "bedrock/nova-pro-v1"
      },
      "google": {
        "google.gemini-3-flash-text": "gemini/gemini-3-flash-preview",
        "google.gemini-2.5-text": "gemini/gemini-2.5-pro",
        "google.gemini-flash-latest-text": "gemini/gemini-flash-latest",
        "google.gemini-pro-latest-text": "gemini/gemini-pro-latest",
        "google.gemini-2.5-flash-file-based-agent": "gemini/gemini-2.5-flash",
        "google.gemini-2.5-flash-multimodal": "gemini/gemini-2.5-flash"
      }
    }'

LITELLM_API_VERSION=2024-02-01

DOCUMENT_SERVICE_URL=http://deps-document-api:8000
FILE_SERVICE_URL=http://deps-file:8000
PARSING_SERVICE_URL=http://deps-parsing:8000
EXTRACTION_URL=http://deps-extraction:8000
FILE_STORAGE_URL=http://deps-file-storage:8004
META_AGENT_URL=http://deps-meta-agent:8000
AGENTIC_AI_URL=http://deps-agentic-ai:8000
GENAI_QUERY_AGENT_URL=http://deps-ai-fusion-agent:8000
UNIFIER_URL=http://deps-unifier:8000

EPAM_DIAL_ENDPOINT=https://ai-proxy.lab.epam.com
EPAM_DIAL_API_KEY=...
EPAM_DIAL_API_VERSION=2023-03-15-preview

AZURE_API_ENDPOINT=https://ai-proxy.lab.epam.com
AZURE_API_KEY=...
AZURE_API_VERSION=2023-03-15-preview

OPENAI_API_KEY=...

AWS_BEDROCK_SECRET_ACCESS_KEY=...
AWS_BEDROCK_ACCESS_KEY_ID=...
AWS_BEDROCK_REGION=us-east-1

GOOGLE_API_KEY=...


# Telemetry
INSTRUMENTATION_ENABLED=false
SERVICE_NAME=deps-ai-fusion
EXPORTER_TYPE=azure

# otlp example
OTLP_LOG_ENDPOINT=http://deps-otlp:4317
OTLP_TRACE_ENDPOINT=http://deps-otlp:4318/v1/traces
APPLICATION_INSIGHTS_CONNECTION_STRING=connection_string

LLM_COORDINATES_ENABLED=false

LLMS_CONFIG='{
        "providers": {
            "azure": {
                "plain_layout_application": [
                    {
                        "name": "GPT-5 Mini",
                        "code": "openai.gpt-5-mini-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^(?=.*gpt)(?=.*5)(?=.*mini).*",
                        "description": "Uses OpenAI GPT-5 Mini. Answers based on document layout.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "logprobs", "extra_model_params"]
                    },
                    {
                        "name": "GPT-4",
                        "code": "openai.gpt-4-omni-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^(?=.*gpt)(?=.*4o)(?!.*mini).*",
                        "description": "Uses OpenAI GPT-4 Omni for high-quality answers from the document. Large 128k context, higher quality and cost than GPT-4 Mini. Answers based on document layout.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "logprobs", "extra_model_params"]
                    }
                ]
            },
            "dial": {
                "plain_blob_application": [
                    {
                        "name": "Dial-RAG",
                        "code": "epam.dial-rag",
                        "context_type": "blob-based",
                        "vendor_code_regex": "(?i)^(?=.*dial)(?=.*rag).*",
                        "description": "EPAM Dial RAG: citation-based answers from the document. Formats: PDF (vector layer), DOC/DOCX, PPT/PPTX, plain text.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "logprobs", "extra_model_params"]
                    },
                    {
                        "name": "Claude 4.6 Images",
                        "code": "anthropic.claude-4.6-multimodal",
                        "context_type": "blob-based",
                        "vendor_code_regex": "(?i)^(?=.*anthropic)(?=.*claude)(?=.*sonnet)(?=.*4[.-]6).*",
                        "description": "Anthropic Claude 4.6 Sonnet (multimodal): document layout plus images (PNG, JPEG, and similar) for context.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "logprobs", "extra_model_params"]
                    }
                ],
                "plain_layout_application": [
                    {
                        "name": "GPT-4.1 Mini",
                        "code": "openai.gpt-4.1-mini-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^(?=.*gpt)(?=.*4\\.1)(?=.*mini).*",
                        "description": "Uses OpenAI GPT-4.1 Mini. Faster and lower cost than full GPT-4-class models. Answers based on document layout.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "logprobs", "extra_model_params"]
                    },
                    {
                        "name": "GPT-4",
                        "code": "openai.gpt-4-omni-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^(?=.*gpt)(?=.*4o)(?!.*mini).*",
                        "description": "Uses OpenAI advanced GPT-4 Omni model, to provide high-quality answers based on the provided document. Has a large 128k context window, better quality, but higher price, in comparison with GPT-4 Mini. Answers based on document layout",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "logprobs", "extra_model_params"]
                    },
                    
                    {
                        "name": "Anthropic Claude Haiku 4.5",
                        "code": "anthropic.claude-haiku-4-5",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^(?=.*anthropic)(?=.*claude)(?=.*haiku)(?=.*4[.-]5).*",
                        "description": "Claude Haiku 4.5: fast, cost-efficient model for high-volume tasks, agents, and sub-agent routing while retaining strong instruction following and tool use.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "logprobs", "extra_model_params"]
                    },
                    {
                        "name": "Anthropic Claude Sonnet 4.5",
                        "code": "anthropic.claude-sonnet-4-5",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^(?=.*anthropic)(?=.*claude)(?=.*sonnet)(?=.*4[.-]5).*",
                        "description": "Claude Sonnet 4.5: capable model for agents, multi-step tasks, coding, analysis, and document layout. Balances quality, speed, and cost for high-volume use.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "logprobs", "extra_model_params"]
                    },
                    {
                        "name": "GPT-5 Mini", 
                        "code": "openai.gpt-5-mini-text", 
                        "context_type": "text-based", 
                        "vendor_code_regex": "(?i)^(?=.*gpt)(?=.*5)(?=.*mini).*", 
                        "description": "OpenAI GPT-5 Mini: reasoning and tool use for apps and agents. Answers based on document layout.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "extra_model_params"]
                    }
                ]
            },
            "google": {
                "plain_blob_application": [
                    {
                        "name": "Gemini 2.5 Flash File-Based Agent",
                        "code": "google.gemini-2.5-flash-file-based-agent",
                        "context_type": "blob-based",
                        "vendor_code_regex": "(?i)^models/gemini-2\\.5-flash$",
                        "description": "Gemini 2.5 Flash on original files (no layout parsing pipeline). Stateless agent; task-focused queries. Formats: PDF, PNG, JPEG, TIF, DOCX.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "extra_model_params"]
                    }
                ],
                "plain_layout_application": [
                    {
                        "name": "Gemini 3 Flash",
                        "code": "google.gemini-3-flash-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^models/gemini-3-flash-preview$",
                        "description": "Google Gemini 3 Flash (preview): fast, low-latency, cost-efficient answers from document layout.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "extra_model_params"]
                    },
                    {
                        "name": "Gemini 2.5 Pro",
                        "code": "google.gemini-2.5-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^models/gemini-2\\.5-pro$",
                        "description": "Google Gemini 2.5 Pro: stronger reasoning and document understanding than Flash, larger context, higher cost.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "extra_model_params"]
                    },
                    {
                        "name": "Gemini Flash Latest",
                        "code": "google.gemini-flash-latest-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^models/gemini-flash-latest$",
                        "description": "Google gemini-flash-latest alias: tracks the default Flash model name as Google updates it.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "extra_model_params"]
                    },
                    {
                        "name": "Gemini Pro Latest",
                        "code": "google.gemini-pro-latest-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^models/gemini-pro-latest$",
                        "description": "Google gemini-pro-latest alias: tracks the default Pro model name as Google updates it.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "extra_model_params"]
                    }
                ],
                "multimodal_application": [
                   {
                        "name": "Gemini 2.5 Flash Multimodal",
                        "code": "google.gemini-2.5-flash-multimodal",
                        "context_type": "multimodal",
                        "vendor_code_regex": "(?i)^models/gemini-2\\.5-flash$",
                        "description": "Google Gemini 2.5 Flash (multimodal): document layout plus files. Formats: PDF, PNG, JPEG, TIF, DOCX.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "extra_model_params"]
                    }
                ]
            },
            "openai": {
                "plain_layout_application": [
                    {
                        "name": "GPT-4 Mini",
                        "code": "openai.gpt-4-omni-mini-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^(?=.*gpt)(?=.*4o)(?=.*mini).*",
                        "description": "Uses OpenAI GPT-4 Omni Mini. Lower cost and latency than GPT-4 Omni. Answers based on document layout.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "logprobs", "extra_model_params"]
                    },
                    {
                        "name": "GPT-4",
                        "code": "openai.gpt-4-omni-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^(?=.*gpt)(?=.*4o)(?!.*mini).*",
                        "description": "Uses OpenAI GPT-4 Omni for high-quality answers from the document. Large 128k context, higher quality and cost than GPT-4 Mini. Answers based on document layout.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "logprobs", "extra_model_params"]
                    },
                    {
                        "name": "Anthropic Claude Sonnet 4.5",
                        "code": "anthropic.claude-sonnet-4-5",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^(?=.*anthropic)(?=.*claude)(?=.*sonnet)(?=.*4\\.5).*",
                        "description": "Claude Sonnet 4.5: capable model for analysis and document layout. Balances quality, speed, and cost for high-volume use.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "logprobs", "extra_model_params"]
                    },
                    {
                        "name": "GPT-5 Mini", 
                        "code": "openai.gpt-5-mini-text", 
                        "context_type": "text-based", 
                        "vendor_code_regex": "(?i)^(?=.*gpt)(?=.*5)(?=.*mini).*", 
                        "description": "OpenAI GPT-5 Mini: reasoning and tool use for apps. Answers based on document layout.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "seed", "extra_model_params"]
                    }
                ]
            },
            "aws-bedrock": {
                "plain_layout_application": [
                    {
                        "name": "Amazon Nova Pro 1",
                        "code": "amazon.nova-pro-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^us\\.amazon\\.nova-pro-v1:0$",
                        "description": "Amazon Nova Pro: large context, strong document answers, higher cost than lighter models. Answers based on document layout.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "extra_model_params"]
                    },
                    {
                        "name": "Claude 4.5",
                        "code": "anthropic.claude-4.5-text",
                        "context_type": "text-based",
                        "vendor_code_regex": "(?i)^us\\.anthropic\\.claude-sonnet-4-5-20250929-v1:0$",
                        "description": "Anthropic Claude 4.5 Sonnet (text): document layout, strong for coding and long-running workflows.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "extra_model_params"]
                    }
                ],
                "plain_blob_application": [
                    {
                        "name": "Claude 4.5 Images",
                        "code": "anthropic.claude-images",
