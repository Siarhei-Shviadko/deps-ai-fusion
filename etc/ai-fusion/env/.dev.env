                        "description": "Anthropic Claude 4.6 Sonnet (multimodal): document layout plus images (PNG, JPEG, and similar) for context.",
                        "parameter_support": ["temperature", "top_p", "max_tokens", "stop", "extra_model_params"]
                    }
                ]
            }
        }
    }
'

MODEL_CAPABILITY_OVERRIDES = '
{
    "openai.gpt-5-mini-text": {"logprobs": "NOT_SUPPORTED"},
    "google.gemini-2.5-flash-file-based-agent": {"logprobs": "NOT_SUPPORTED"}
}
'

AGENT_MODEL_ID=gpt-4o
